# ── Database (SQLite for local dev — no installation needed) ──────────────────
DATABASE_URL=sqlite+aiosqlite:///./fitcoach.db
DATABASE_URL_SYNC=sqlite:///./fitcoach.db

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change this in production — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=dev-secret-change-in-production-abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (dev prints to console; set SMTP creds for real emails) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FitCoach AI <noreply@fitcoach.ai>

# ── AI ────────────────────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000","http://10.180.16.12:8000","http://172.20.10.2:8000"]

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
